<Window x:Class="KubSMTP.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
   <Grid x:Name="AppHeader" Padding="20,0,140,0" ColumnSpacing="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Image Source="Assets/KubSMTP.png" Width="26" Height="26"/>
    <TextBlock Grid.Column="1" Text="KubSMTP" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="2" Text="SMTP Test Tool" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Padding="20,18,20,18" ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4"><TextBlock x:Name="pageTitle" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="intro" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
   <Button x:Name="toggleLog" Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE756;" FontSize="15"/><TextBlock x:Name="toggleLabel"/></StackPanel></Button>
  </Grid>
  <Grid x:Name="workspace" Grid.Row="2" Margin="20,0,20,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.24*" MinWidth="320"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollView x:Name="formScroll" ContentOrientation="Vertical" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled" IgnoredInputKinds="None" Background="Transparent">
    <StackPanel x:Name="fields" Spacing="14" Padding="0,0,3,0">
     <Border Style="{StaticResource Card}">
      <StackPanel Spacing="10">
       <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2"><FontIcon Glyph="&#xE968;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="16"/><TextBlock x:Name="connectionTitle" FontWeight="SemiBold" FontSize="14"/></StackPanel>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Name="hostLabel"/><TextBox x:Name="host" PlaceholderText="smtp.example.test"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Port"/><ComboBox x:Name="portSelection"/><TextBox x:Name="port" Text="587" InputScope="Number" PlaceholderText="1–65535" Visibility="Collapsed"/></StackPanel></Grid>
       <StackPanel Spacing="4"><TextBlock x:Name="encryptionLabel"/><ComboBox x:Name="encryption"/></StackPanel>
       <StackPanel Spacing="4"><TextBlock x:Name="authLabel"/><ComboBox x:Name="authentication"/></StackPanel>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Name="userLabel"/><TextBox x:Name="user"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="secretLabel"/><PasswordBox x:Name="secret"/></StackPanel></Grid>
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="sessionHint" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="testConnection" Grid.Column="1"/></Grid>
       <Expander x:Name="profileOptions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" BorderThickness="0" MinHeight="28"><StackPanel Spacing="8"><CheckBox x:Name="remember" FontSize="12"><TextBlock x:Name="rememberLabel" TextWrapping="Wrap" FontSize="12"/></CheckBox><Button x:Name="saveProfile"/></StackPanel></Expander>

      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel Spacing="10">
       <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2"><FontIcon Glyph="&#xE715;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="16"/><TextBlock x:Name="messageTitle" FontWeight="SemiBold" FontSize="14"/></StackPanel>
       <StackPanel Spacing="4"><TextBlock x:Name="fromLabel"/><TextBox x:Name="from"/></StackPanel>
       <StackPanel Spacing="4"><TextBlock x:Name="toLabel"/><TextBox x:Name="to"/></StackPanel>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Name="ccLabel"/><TextBox x:Name="cc" PlaceholderText="team@example.test"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="bccLabel"/><TextBox x:Name="bcc" PlaceholderText="archiv@example.test"/></StackPanel></Grid>
       <StackPanel Spacing="4"><TextBlock x:Name="subjectLabel"/><TextBox x:Name="subject"/></StackPanel>
       <StackPanel Spacing="6"><TextBlock x:Name="bodyLabel"/><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="format" MinHeight="28" Padding="8,3" FontSize="12" MinWidth="110"/><ComboBox x:Name="charset" MinHeight="28" Padding="8,3" FontSize="12" MinWidth="142"/></StackPanel></StackPanel>
       <TextBox x:Name="body" AcceptsReturn="True" TextWrapping="Wrap" Height="132" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.IsVerticalScrollChainingEnabled="True"/>
       <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="addAttachment"/><TextBlock x:Name="attachmentSummary" Style="{StaticResource Caption}" VerticalAlignment="Center"/></StackPanel>
       <StackPanel x:Name="attachments" Spacing="4"/>
       <Grid BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="draftMenu"><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="saveDraft"/><MenuFlyoutItem x:Name="openDraft"/></MenuFlyout></Button.Flyout></Button><TextBlock x:Name="status" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="180"/></StackPanel><Button x:Name="send" Grid.Column="1" Style="{StaticResource AccentButtonStyle}"/></Grid>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollView>
   <Thumb x:Name="divider" Grid.Column="1" Background="Transparent"/>
   <Border x:Name="logPanel" Grid.Column="2" Background="#101823" BorderBrush="#26394D" BorderThickness="1" CornerRadius="8" RequestedTheme="Dark">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Padding="16" BorderBrush="#2B394A" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE756;" FontSize="16" Foreground="#EDF3FC"/><TextBlock x:Name="logTitle" FontWeight="SemiBold" FontSize="14" Foreground="#EDF3FC"/></StackPanel><TextBlock x:Name="logSubtitle" FontSize="11" Foreground="#A5B9D1"/></StackPanel><Border Grid.Column="1" Background="#163A30" CornerRadius="4" Padding="7,4" VerticalAlignment="Top"><TextBlock x:Name="logState" FontSize="10" Foreground="#A8E8C4" CharacterSpacing="80"/></Border></Grid>
     <Grid Grid.Row="1" Padding="14,8" BorderBrush="#2B394A" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="C → Client · S → Server" FontSize="11" Foreground="#A5B9D1" VerticalAlignment="Center"/><Button x:Name="clearLog" Grid.Column="1" Style="{StaticResource LogButton}"/></Grid>
     <ScrollViewer x:Name="logScroll" Grid.Row="2" Padding="14,16" HorizontalScrollBarVisibility="Disabled"><RichTextBlock x:Name="logText" FontFamily="Consolas" FontSize="12" Foreground="#C6D2E3" IsTextSelectionEnabled="True"/></ScrollViewer>
     <StackPanel Grid.Row="3" Padding="14,10" Spacing="8" BorderBrush="#2B394A" BorderThickness="0,1,0,0"><TextBlock x:Name="redactionHint" FontSize="11" Foreground="#A5B9D1" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="copyLog" Style="{StaticResource LogButton}"/><Button x:Name="exportLog" Style="{StaticResource LogButton}"/><CheckBox x:Name="follow" IsChecked="True" Content="Autoscroll" FontSize="11" MinWidth="0" Foreground="#C6D2E3"/><ToggleButton x:Name="pause" MinWidth="28" MinHeight="28" Padding="5" CornerRadius="4" Background="Transparent" Foreground="#C6D2E3"><FontIcon Glyph="&#xE769;" FontSize="12"/></ToggleButton></StackPanel></StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="3" Padding="20,9" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="storageLabel" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="cancel" Grid.Column="1" Visibility="Collapsed" MinHeight="26" Padding="10,2"/><TextBlock x:Name="versionLabel" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center"/></Grid>
 </Grid>
</Window>
