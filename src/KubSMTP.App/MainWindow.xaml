<Window x:Class="KubSMTP.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{ThemeResource WindowDividerBrush}" BorderThickness="0,0,0,1">
   <Grid x:Name="AppHeader" Padding="20,0,140,0" ColumnSpacing="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Image Source="Assets/KubSMTP.png" Width="26" Height="26"/>
    <TextBlock Grid.Column="1" Text="KubSMTP" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="2" Text="SMTP Test Tool" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Padding="20,18,20,18" ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4"><TextBlock x:Name="pageTitle" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="intro" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
   <Button x:Name="toggleLog" Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE756;" FontSize="15"/><TextBlock x:Name="toggleLabel"/></StackPanel></Button>
  </Grid>
  <Grid x:Name="workspace" Grid.Row="2" Margin="20,0,20,18" VerticalAlignment="Top">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.24*" MinWidth="320"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="formScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled" Background="Transparent">
    <StackPanel x:Name="fields" Spacing="14" Padding="0,0,3,0" VerticalAlignment="Top">
     <Border Style="{StaticResource Card}">
      <StackPanel Spacing="10">
       <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2"><FontIcon Glyph="&#xE968;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="16"/><TextBlock x:Name="connectionTitle" FontWeight="SemiBold" FontSize="14"/></StackPanel>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Name="hostLabel"/><TextBox x:Name="host" PlaceholderText="smtp.example.test"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Port"/><ComboBox x:Name="portSelection"/><TextBox x:Name="port" Text="587" InputScope="Number" PlaceholderText="1–65535" Visibility="Collapsed"/></StackPanel></Grid>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Name="encryptionLabel"/><ComboBox x:Name="encryption"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="authLabel"/><ComboBox x:Name="authentication"/></StackPanel></Grid>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Name="userLabel"/><TextBox x:Name="user"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="secretLabel"/><PasswordBox x:Name="secret"/></StackPanel></Grid>
       <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Expander x:Name="profileOptions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" BorderThickness="0" MinHeight="34"><StackPanel Spacing="8"><TextBlock x:Name="sessionHint" Style="{StaticResource Caption}" TextWrapping="Wrap"/><CheckBox x:Name="remember" FontSize="12"><TextBlock x:Name="rememberLabel" TextWrapping="Wrap" FontSize="12"/></CheckBox><Button x:Name="saveProfile"/></StackPanel></Expander>
        <Button x:Name="testConnection" Grid.Column="1" VerticalAlignment="Top"/>
       </Grid>

      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel Spacing="10">
       <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2"><FontIcon Glyph="&#xE715;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="16"/><TextBlock x:Name="messageTitle" FontWeight="SemiBold" FontSize="14"/></StackPanel>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Name="fromLabel"/><TextBox x:Name="from"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="toLabel"/><TextBox x:Name="to"/></StackPanel></Grid>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Name="ccLabel"/><TextBox x:Name="cc" PlaceholderText="team@example.test"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="bccLabel"/><TextBox x:Name="bcc" PlaceholderText="archiv@example.test"/></StackPanel></Grid>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Name="subjectLabel"/><TextBox x:Name="subject"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="bodyLabel"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="format" Padding="8,6" FontSize="12" MinWidth="0"/><ComboBox x:Name="charset" Grid.Column="1" Padding="8,6" FontSize="12" MinWidth="0"/></Grid></StackPanel></Grid>
       <TextBox x:Name="body" AcceptsReturn="True" TextWrapping="Wrap" Height="132" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.IsVerticalScrollChainingEnabled="True"/>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="addAttachment" HorizontalAlignment="Stretch"/><Button x:Name="draftMenu" Grid.Column="1" HorizontalAlignment="Stretch"><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="saveDraft"/><MenuFlyoutItem x:Name="openDraft"/></MenuFlyout></Button.Flyout></Button></Grid>
       <StackPanel x:Name="attachments" Spacing="4"/>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock x:Name="attachmentSummary" Style="{StaticResource Caption}" TextWrapping="Wrap"/><TextBlock x:Name="status" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Button x:Name="send" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/></Grid>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Thumb x:Name="divider" Grid.Column="1" Background="Transparent"/>
   <Border x:Name="logPanel" Grid.Column="2" Background="#0C1511" BorderBrush="#334C3E" BorderThickness="1" CornerRadius="12" RequestedTheme="Dark">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Padding="24,22,24,0" RowSpacing="12" ColumnSpacing="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="logTitle" FontFamily="Consolas" FontWeight="Bold" FontSize="18" Foreground="#F3F6F4" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE768;" FontSize="14" Foreground="#43E889"/><TextBlock x:Name="logState" FontFamily="Consolas" FontSize="14" Foreground="#43E889"/></StackPanel>
      <TextBlock x:Name="logSubtitle" Grid.Row="1" Grid.ColumnSpan="2" FontFamily="Consolas" FontSize="12" Foreground="#9BAFA4" TextWrapping="Wrap"/>
     </Grid>
     <ScrollViewer x:Name="logScroll" Grid.Row="1" Padding="24,20,24,12" HorizontalScrollBarVisibility="Disabled"><RichTextBlock x:Name="logText" FontFamily="Consolas" FontSize="14" Foreground="#86E9A8" IsTextSelectionEnabled="True"/></ScrollViewer>
     <StackPanel Grid.Row="2" Padding="24,8,24,16" Spacing="8">
      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="redactionHint" FontFamily="Consolas" FontSize="11" Foreground="#9BAFA4" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="clearLog" Grid.Column="1" Style="{StaticResource LogButton}"/></Grid>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="copyLog" Style="{StaticResource LogButton}"/><Button x:Name="exportLog" Style="{StaticResource LogButton}"/><CheckBox x:Name="follow" IsChecked="True" Content="Autoscroll" FontSize="11" MinWidth="0" Foreground="#9BAFA4"/><ToggleButton x:Name="pause" MinWidth="28" MinHeight="28" Padding="5" CornerRadius="4" Background="Transparent" Foreground="#9BAFA4"><FontIcon Glyph="&#xE769;" FontSize="12"/></ToggleButton></StackPanel>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="3" Padding="20,9" BorderBrush="{ThemeResource WindowDividerBrush}" BorderThickness="0,1,0,0" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="storageLabel" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="cancel" Grid.Column="1" Visibility="Collapsed" MinHeight="26" Padding="10,2"/><TextBlock x:Name="versionLabel" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center"/></Grid>
 </Grid>
</Window>
